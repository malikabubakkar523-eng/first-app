generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  name         String
  email        String         @unique
  passwordHash String
  role         String         @default("CUSTOMER") // "CUSTOMER" | "ADMIN"
  phone        String?
  avatar       String?
  status       String         @default("ACTIVE") // "ACTIVE" | "SUSPENDED" | "INACTIVE"
  lastLoginAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  addresses     Address[]
  orders        Order[]
  reviews       Review[]
  wishlist      WishlistItem[]
  cartItems     CartItem[]
  notifications Notification[]
  activities    UserActivity[]

  orderNotifs   Boolean        @default(true)
  dealNotifs    Boolean        @default(true)
  promoEmails   Boolean        @default(true)
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  action    String   @default("LOGIN") // "LOGIN" | "LOGOUT" | "REGISTER" | "PASSWORD_CHANGE" | "EMAIL_CHANGE"
  status    String   @default("SUCCESS") // "SUCCESS" | "FAILED"
  ipAddress String?
  userAgent String?
  device    String?
  details   String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([email])
}

model EmailLog {
  id             String   @id @default(uuid())
  recipientEmail String
  recipientName  String?
  subject        String
  message        String?
  type           String   @default("ORDER") // "ORDER" | "WELCOME" | "ADMIN_CUSTOM" | "PROMOTION"
  status         String   @default("SENT") // "SENT" | "FAILED" | "PENDING"
  resendId       String?
  error          String?
  sender         String?  @default("VELOCE Atelier")
  createdAt      DateTime @default(now())

  @@index([recipientEmail])
  @@index([createdAt])
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String?
  phone      String?
  street     String
  city       String
  state      String
  postalCode String
  country    String   @default("United States")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  logo        String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products    Product[]
}

model Product {
  id          String         @id @default(uuid())
  name        String
  slug        String         @unique
  description String
  details     String?        // Additional specs
  price       Float
  salePrice   Float?
  sku         String         @unique
  categoryId  String
  category    Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  brandId     String?
  brand       Brand?         @relation(fields: [brandId], references: [id], onDelete: SetNull)
  isFeatured  Boolean        @default(false)
  isNew       Boolean        @default(false)
  status      String         @default("ACTIVE") // "ACTIVE" | "ARCHIVED" | "DELETED"
  rating      Float          @default(5.0)
  reviewCount Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  images      ProductImage[]
  sizes       ProductSize[]
  variants    ProductVariant[]
  reviews     Review[]
  orderItems  OrderItem[]
  cartItems   CartItem[]
  wishlist    WishlistItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status, isFeatured])
  @@index([status, isNew])
  @@index([status, price])
  @@index([rating])
  @@index([createdAt])
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  isPrimary Boolean  @default(false)
  order     Int      @default(0)

  @@index([productId, order])
}

model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  colorName String
  colorHex  String
  image     String?

  @@index([productId])
}

model ProductSize {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String   // e.g. "39", "40", "41", "42", "43", "44", "45"
  stock     Int      @default(0)
  sku       String?

  @@index([productId, size])
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String
  color     String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique
  userId            String?
  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName      String
  customerEmail     String
  customerPhone     String?
  shippingAddress   String      // JSON serialized or full string
  paymentMethod     String      @default("CASH_ON_DELIVERY") // "CASH_ON_DELIVERY" | "ONLINE_PAYMENT"
  paymentStatus     String      @default("PENDING") // "PENDING" | "PAID" | "FAILED" | "REFUNDED"
  orderStatus       String      @default("PENDING") // "PENDING" | "CONFIRMED" | "PROCESSING" | "SHIPPED" | "DELIVERED" | "CANCELLED" | "RETURNED"
  subtotal          Float
  discount          Float       @default(0)
  shippingFee       Float       @default(0)
  tax               Float       @default(0)
  total             Float
  couponCode        String?
  notes             String?
  trackingNumber    String?
  estimatedDelivery DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items             OrderItem[]

  @@index([userId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName  String
  productImage String?
  size         String
  color        String?
  price        Float
  quantity     Int
  total        Float

  @@index([orderId])
  @@index([productId])
}

model Deal {
  id                    String                @id @default(uuid())
  title                 String
  subtitle              String?
  badge                 String? // e.g. "SPECIAL OFFER", "FLASH SALE"
  bannerImage           String?
  discountPercent       Float?
  fixedDiscount         Float?
  startDate             DateTime              @default(now())
  endDate               DateTime
  isActive              Boolean               @default(true)
  isNotificationEnabled Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  notificationLogs      DealNotificationLog[]

  @@index([isActive, endDate])
}

model DealNotificationLog {
  id        String   @id @default(uuid())
  dealId    String
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId    String?
  channel   String   // "IN_APP" | "EMAIL"
  status    String   @default("SENT") // "SENT" | "FAILED" | "PENDING"
  sentAt    DateTime @default(now())
  error     String?
  createdAt DateTime @default(now())

  @@index([dealId, channel])
  @@index([userId, dealId, channel])
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  description    String?
  discountType   String    @default("PERCENTAGE") // "PERCENTAGE" | "FIXED"
  discountValue  Float
  minOrderAmount Float?    @default(0)
  maxDiscount    Float?
  usageLimit     Int?
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive, code])
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userName   String
  userAvatar String?
  rating     Int      @default(5)
  comment    String
  isVerified Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([productId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   @default("SYSTEM") // "ORDER" | "DEAL" | "SYSTEM" | "PROMOTION"
  isRead    Boolean  @default(false)
  orderId   String?
  dealId    String?
  productId String?
  createdAt DateTime @default(now())

  @@index([userId, isRead])
}

model GalleryItem {
  id          String   @id @default(uuid())
  title       String
  category    String   @default("ALL") // "MEN" | "WOMEN" | "EDITORIAL" | "STREETWEAR"
  imageUrl    String
  description String?
  shoeModel   String?
  link        String?  // Optional CTA link
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

model HeroBanner {
  id          String   @id @default(uuid())
  heading     String
  subtitle    String?
  badge       String?  @default("SPRING / SUMMER 2026 ARCHIVE")
  imageUrl    String
  ctaText     String?  @default("SHOP THE COLLECTION")
  ctaLink     String?  @default("/shop")
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

model StoreSettings {
  id                     String   @id @default("default")
  storeName              String   @default("VELOCE")
  logo                   String?
  currencySymbol         String   @default("$")
  currencyCode           String   @default("USD")
  supportEmail           String   @default("support@veloce-shoes.com")
  supportPhone           String   @default("+1 (800) 835-6231")
  address                String   @default("888 Madison Avenue, New York, NY 10021")
  freeShippingThreshold  Float    @default(150)
  defaultShippingFee     Float    @default(15)
  announcement           String?  @default("Complimentary global express shipping on all orders over $150. Use code VELOCE20 for 20% off.")
  isMaintenanceMode      Boolean  @default(false)
  updatedAt              DateTime @updatedAt
}

model OtpToken {
  id         String    @id @default(uuid())
  email      String
  codeHash   String    // Hashed 6-digit verification code
  purpose    String    // "GOOGLE_LOGIN" | "PASSWORD_RESET"
  userData   String?   // JSON serialized payload for google new user registration
  expiresAt  DateTime
  attempts   Int       @default(0)
  lastSentAt DateTime  @default(now())
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}
