generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          String         @default("CUSTOMER")
  phone         String?
  avatar        String?
  status        String         @default("ACTIVE")
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  orderNotifs   Boolean        @default(true)
  dealNotifs    Boolean        @default(true)
  promoEmails   Boolean        @default(true)
  addresses     Address[]
  cartItems     CartItem[]
  notifications Notification[]
  orders        Order[]
  reviews       Review[]
  activities    UserActivity[]
  wishlist      WishlistItem[]
}

model UserActivity {
  id        String   @id @default(uuid())
  userId    String?
  email     String
  action    String   @default("LOGIN")
  status    String   @default("SUCCESS")
  ipAddress String?
  userAgent String?
  device    String?
  details   String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([email])
}

model EmailLog {
  id             String   @id @default(uuid())
  recipientEmail String
  recipientName  String?
  subject        String
  message        String?
  type           String   @default("ORDER")
  status         String   @default("SENT")
  resendId       String?
  error          String?
  sender         String?  @default("VELOCE Atelier")
  createdAt      DateTime @default(now())

  @@index([recipientEmail])
  @@index([createdAt])
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  fullName   String?
  phone      String?
  street     String
  city       String
  state      String
  postalCode String
  country    String   @default("United States")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  logo        String?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id          String           @id @default(uuid())
  name        String
  slug        String           @unique
  description String
  details     String?
  price       Float
  salePrice   Float?
  sku         String           @unique
  categoryId  String
  brandId     String?
  isFeatured  Boolean          @default(false)
  isNew       Boolean          @default(false)
  status      String           @default("ACTIVE")
  rating      Float            @default(5.0)
  reviewCount Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  cartItems   CartItem[]
  orderItems  OrderItem[]
  brand       Brand?           @relation(fields: [brandId], references: [id])
  category    Category         @relation(fields: [categoryId], references: [id])
  images      ProductImage[]
  sizes       ProductSize[]
  variants    ProductVariant[]
  reviews     Review[]
  wishlist    WishlistItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status, isFeatured])
  @@index([status, isNew])
  @@index([status, price])
  @@index([rating])
  @@index([createdAt])
}

model ProductImage {
  id        String  @id @default(uuid())
  productId String
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  order     Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, order])
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  colorName String
  colorHex  String
  image     String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSize {
  id        String  @id @default(uuid())
  productId String
  size      String
  stock     Int     @default(0)
  sku       String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, size])
}

model CartItem {
  id        String   @id @default(uuid())
  userId    String?
  productId String
  size      String
  color     String?
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([productId])
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique
  userId            String?
  customerName      String
  customerEmail     String
  customerPhone     String?
  shippingAddress   String
  paymentMethod     String      @default("CASH_ON_DELIVERY")
  paymentStatus     String      @default("PENDING")
  orderStatus       String      @default("PENDING")
  subtotal          Float
  discount          Float       @default(0)
  shippingFee       Float       @default(0)
  tax               Float       @default(0)
  total             Float
  couponCode        String?
  notes             String?
  trackingNumber    String?
  estimatedDelivery DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  user              User?       @relation(fields: [userId], references: [id])
  items             OrderItem[]

  @@index([userId])
  @@index([orderStatus])
  @@index([paymentStatus])
  @@index([createdAt])
}

model OrderItem {
  id           String   @id @default(uuid())
  orderId      String
  productId    String?
  productName  String
  productImage String?
  size         String
  color        String?
  price        Float
  quantity     Int
  total        Float
  product      Product? @relation(fields: [productId], references: [id])
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([productId])
}

model Deal {
  id                    String                @id @default(uuid())
  title                 String
  subtitle              String?
  badge                 String?
  bannerImage           String?
  discountPercent       Float?
  fixedDiscount         Float?
  startDate             DateTime              @default(now())
  endDate               DateTime
  isActive              Boolean               @default(true)
  isNotificationEnabled Boolean               @default(false)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  notificationLogs      DealNotificationLog[]

  @@index([isActive, endDate])
}

model DealNotificationLog {
  id        String   @id @default(uuid())
  dealId    String
  userId    String?
  channel   String
  status    String   @default("SENT")
  sentAt    DateTime @default(now())
  error     String?
  createdAt DateTime @default(now())
  deal      Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([dealId, channel])
  @@index([userId, dealId, channel])
}

model Coupon {
  id             String    @id @default(uuid())
  code           String    @unique
  description    String?
  discountType   String    @default("PERCENTAGE")
  discountValue  Float
  minOrderAmount Float?    @default(0)
  maxDiscount    Float?
  usageLimit     Int?
  usedCount      Int       @default(0)
  expiresAt      DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([isActive, code])
}

model Review {
  id         String   @id @default(uuid())
  productId  String
  userId     String?
  userName   String
  userAvatar String?
  rating     Int      @default(5)
  comment    String
  isVerified Boolean  @default(true)
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("SYSTEM")
  isRead    Boolean  @default(false)
  orderId   String?
  dealId    String?
  productId String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model GalleryItem {
  id          String   @id @default(uuid())
  title       String
  category    String   @default("ALL")
  imageUrl    String
  videoUrl    String?
  mediaType   String?  @default("image")
  description String?
  shoeModel   String?
  link        String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, order])
}

model HeroBanner {
  id        String   @id @default(uuid())
  heading   String
  subtitle  String?
  badge     String?  @default("SPRING / SUMMER 2026 ARCHIVE")
  imageUrl  String
  videoUrl  String?
  mediaType String?  @default("image")
  ctaText   String?  @default("SHOP THE COLLECTION")
  ctaLink   String?  @default("/shop")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

model ShopBanner {
  id        String   @id @default("default")
  badge     String?  @default("NEW ARRIVALS • SPRING/SUMMER 2026")
  heading   String   @default("FRESH STYLES. BOLD MOVES.")
  subtitle  String?  @default("Step into the new season with premium comfort and effortless style. High performance meets runway aesthetics.")
  imageUrl  String   @default("/images/shop-banner.png")
  videoUrl  String?
  mediaType String   @default("image")
  ctaText   String?  @default("SHOP NEW ARRIVALS")
  ctaLink   String?  @default("/shop?sort=newest")
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model StoreSettings {
  id                    String   @id @default("default")
  storeName             String   @default("VELOCE")
  logo                  String?
  currencySymbol        String   @default("Rs.")
  currencyCode          String   @default("PKR")
  supportEmail          String   @default("support@veloce-shoes.com")
  supportPhone          String   @default("+92 (51) 835-6231")
  address               String   @default("Blue Area, Islamabad, Pakistan")
  freeShippingThreshold Float    @default(5000)
  defaultShippingFee    Float    @default(250)
  announcement          String?  @default("Complimentary nationwide express shipping on all orders over Rs. 5,000. Use code VELOCE20 for 20% off.")
  isMaintenanceMode     Boolean  @default(false)
  updatedAt             DateTime @updatedAt
}

model OtpToken {
  id         String    @id @default(uuid())
  email      String
  codeHash   String
  purpose    String
  userData   String?
  expiresAt  DateTime
  attempts   Int       @default(0)
  lastSentAt DateTime  @default(now())
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}
